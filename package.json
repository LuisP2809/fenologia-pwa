{
  "name": "fenologia-pwa",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "description": "Evaluaciones fenológicas y biométricas offline para campo.",
  "scripts": {
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "build:web": "node scripts/prepare-web.mjs",
    "android:init": "npm run build:web && npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "apk:debug": "node scripts/build-apk.mjs",
    "android:signing:setup": "bash scripts/configurar-firma-android.sh",
    "android:release:configure": "node scripts/configure-android-version.mjs",
    "android:release:trigger": "node scripts/trigger-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
